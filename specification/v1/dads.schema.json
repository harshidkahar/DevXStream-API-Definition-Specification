{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devxstream.com/schemas/dads/v1.json",
  "title": "DevXStream API Definition Specification v1.0",
  "type": "object",
  "required": ["definitionVersion", "application", "modules"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "definitionVersion": { "type": "string", "pattern": "^DADS 1\\.[0-9]+(?:\\.[0-9]+)?(?:-[A-Za-z0-9.-]+)?$" },
    "application": { "$ref": "#/$defs/application" },
    "servers": { "type": "array", "items": { "$ref": "#/$defs/server" }, "default": [] },
    "modules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/module" } },
    "schemas": { "type": "array", "items": { "$ref": "#/$defs/schema" }, "default": [] },
    "securitySchemes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/securityScheme" }, "default": {} }
  },
  "patternProperties": { "^x-[a-z0-9][a-z0-9-]*$": {} },
  "additionalProperties": false,
  "$defs": {
    "application": { "type": "object", "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "framework": { "type": "string" }, "architecture": { "type": "string" } }, "patternProperties": { "^x-[a-z0-9][a-z0-9-]*$": {} }, "additionalProperties": false },
    "server": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "format": "uri-reference", "minLength": 1 }, "description": { "type": "string" } }, "additionalProperties": false },
    "module": { "type": "object", "required": ["name", "endpoints"], "properties": { "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "endpoints": { "type": "array", "items": { "$ref": "#/$defs/endpoint" } }, "order": { "type": "integer", "minimum": 0 } }, "patternProperties": { "^x-[a-z0-9][a-z0-9-]*$": {} }, "additionalProperties": false },
    "endpoint": { "type": "object", "required": ["name", "method", "route", "summary", "responses"], "properties": { "name": { "type": "string", "minLength": 1 }, "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] }, "route": { "type": "string", "pattern": "^/" }, "summary": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "deprecated": { "type": "boolean" }, "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } }, "request": { "$ref": "#/$defs/request" }, "responses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/response" } }, "engineering": { "$ref": "#/$defs/engineering" }, "security": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } }, "patternProperties": { "^x-[a-z0-9][a-z0-9-]*$": {} }, "additionalProperties": false },
    "parameter": { "type": "object", "required": ["name", "in", "type"], "properties": { "name": { "type": "string", "minLength": 1 }, "in": { "type": "string", "enum": ["path", "query", "header", "cookie"] }, "type": { "type": "string", "minLength": 1 }, "required": { "type": "boolean" }, "description": { "type": "string" }, "example": {} }, "additionalProperties": false },
    "request": { "type": "object", "properties": { "schema": { "type": "string" }, "description": { "type": "string" }, "contentType": { "type": "string", "default": "application/json" }, "example": {} }, "additionalProperties": false },
    "response": { "type": "object", "required": ["statusCode", "description"], "properties": { "statusCode": { "type": "string", "pattern": "^(?:[1-5][0-9]{2}|default)$" }, "description": { "type": "string" }, "schema": { "type": "string" }, "contentType": { "type": "string", "default": "application/json" }, "example": {} }, "additionalProperties": false },
    "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "type": { "type": "string" }, "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/property" } }, "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "enum": { "type": "array" }, "example": {} }, "additionalProperties": false },
    "property": { "type": "object", "properties": { "type": { "type": "string" }, "format": { "type": "string" }, "description": { "type": "string" }, "nullable": { "type": "boolean" }, "example": {}, "items": { "$ref": "#/$defs/property" } }, "additionalProperties": false },
    "engineering": { "type": "object", "properties": { "cqrs": { "type": "string", "enum": ["Command", "Query"] }, "handler": { "type": "string" }, "authorization": { "type": "string" }, "cache": { "type": "string" }, "transaction": { "type": "string" }, "persistence": { "type": "string" }, "validation": { "type": "string" } }, "patternProperties": { "^x-[a-z0-9][a-z0-9-]*$": {} }, "additionalProperties": false },
    "securityScheme": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string", "enum": ["http", "apiKey"] }, "scheme": { "type": "string" }, "bearerFormat": { "type": "string" }, "in": { "type": "string", "enum": ["header", "query", "cookie"] }, "name": { "type": "string" }, "description": { "type": "string" } }, "allOf": [{ "if": { "properties": { "type": { "const": "apiKey" } } }, "then": { "required": ["in", "name"] } }], "additionalProperties": false }
  }
}
