      "operations": [
        {
          "id": "catalog-listproducts",
          "name": "ListProducts",
          "method": "GET",
          "route": "/products",
          "summary": "List products",
          "description": "Returns a paginated product collection. Results can be filtered by category.",
          "deprecated": false,
          "parameters": [
            {
              "name": "category",
              "in": "query",
              "type": "string",
              "required": false,
              "description": "Limits results to a catalogue category.",
              "example": "lighting"
            },
            {
              "name": "page",
              "in": "query",
              "type": "integer",
              "required": false,
              "description": "One-based page number.",
              "example": 1
            }
          ],
          "request": null,
          "responses": [
            {
              "statusCode": "200",
              "description": "Product page",
              "schema": "Product",
              "contentType": null,
              "example": {
                "items": [
                  {
                    "id": "prd_100",
                    "name": "Arc Lamp",
                    "price": 129.99
                  }
                ],
                "page": 1,
                "total": 1
              }
            }
          ],
          "engineering": {
            "cqrs": "Query",
            "handler": "ListProductsQueryHandler",
            "authorization": "Anonymous",
            "cache": "60 seconds",
            "transaction": null,
            "persistence": null,
            "validation": null
          },
          "requestSnippets": {
            "curl": "curl -X GET \u0027https://api.northstar.example/v1/products\u0027",
            "http": "GET https://api.northstar.example/v1/products HTTP/1.1\nAccept: application/json",
            "csharp": "using var client = new HttpClient();\nusing var request = new HttpRequestMessage(HttpMethod.Get, \u0022https://api.northstar.example/v1/products\u0022);\nusing var response = await client.SendAsync(request);",
            "javascript": "const response = await fetch(\u0022https://api.northstar.example/v1/products\u0022, { method: \u0022GET\u0022 });",
            "python": "response = requests.request(\u0022GET\u0022, \u0022https://api.northstar.example/v1/products\u0022)"
          }
        },
        {
          "id": "catalog-getproduct",
          "name": "GetProduct",
          "method": "GET",
          "route": "/products/{id}",
          "summary": "Get product",
