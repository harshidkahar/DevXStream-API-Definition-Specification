        {
          "id": "orders-createorder",
          "name": "CreateOrder",
          "method": "POST",
          "route": "/orders",
          "summary": "Create order",
          "description": "Creates an order for the authenticated customer.",
          "deprecated": false,
          "parameters": [],
          "request": {
            "schema": "CreateOrderRequest",
            "description": "Products and shipping address selected by the customer.",
            "contentType": "application/json",
            "example": {
              "items": [
                {
                  "productId": "prd_100",
                  "quantity": 1
                }
              ],
              "shippingAddressId": "adr_200"
            }
          },
          "responses": [
            {
              "statusCode": "201",
              "description": "Order created",
              "schema": null,
              "contentType": null,
              "example": {
                "id": "ord_300",
                "status": "Pending"
              }
            },
            {
              "statusCode": "400",
              "description": "Request validation failed",
              "schema": null,
              "contentType": null,
              "example": null
            }
          ],
          "engineering": {
            "cqrs": "Command",
            "handler": "CreateOrderCommandHandler",
            "authorization": "Customer",
            "cache": null,
            "transaction": "Required",
            "persistence": null,
            "validation": null
          },
          "requestSnippets": {
            "curl": "curl -X POST \u0027https://api.northstar.example/v1/orders\u0027 -H \u0027Content-Type: application/json\u0027 --data \u0027{ \u0022items\u0022: [{ \u0022productId\u0022: \u0022prd_100\u0022, \u0022quantity\u0022: 1 }], \u0022shippingAddressId\u0022: \u0022adr_200\u0022 }\u0027",
            "http": "POST https://api.northstar.example/v1/orders HTTP/1.1\nAccept: application/json\nContent-Type: application/json\n\n{ \u0022items\u0022: [{ \u0022productId\u0022: \u0022prd_100\u0022, \u0022quantity\u0022: 1 }], \u0022shippingAddressId\u0022: \u0022adr_200\u0022 }",
            "csharp": "using var client = new HttpClient();\nusing var request = new HttpRequestMessage(HttpMethod.Post, \u0022https://api.northstar.example/v1/orders\u0022);\nrequest.Content = JsonContent.Create({ \u0022items\u0022: [{ \u0022productId\u0022: \u0022prd_100\u0022, \u0022quantity\u0022: 1 }], \u0022shippingAddressId\u0022: \u0022adr_200\u0022 });\nusing var response = await client.SendAsync(request);",
            "javascript": "const response = await fetch(\u0022https://api.northstar.example/v1/orders\u0022, { method: \u0022POST\u0022, headers: { \u0022Content-Type\u0022: \u0022application/json\u0022 }, body: JSON.stringify({ \u0022items\u0022: [{ \u0022productId\u0022: \u0022prd_100\u0022, \u0022quantity\u0022: 1 }], \u0022shippingAddressId\u0022: \u0022adr_200\u0022 }) });",
            "python": "response = requests.request(\u0022POST\u0022, \u0022https://api.northstar.example/v1/orders\u0022, json={ \u0022items\u0022: [{ \u0022productId\u0022: \u0022prd_100\u0022, \u0022quantity\u0022: 1 }], \u0022shippingAddressId\u0022: \u0022adr_200\u0022 })"
          }
        }
      ]
